# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# `AGENTSCAD_BUILD_DIR` can rename the build directory so a production build and
# a running dev server stop fighting over `.next`. A per-name rule misses the
# next name that gets used, so the whole family is ignored at once.
.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pid

# env files — ignore all except .env.example
.env
.env.local
.env.local.*
.env*.bak
!.env.example

# database (runtime-generated)
db/*.db

# generated artifacts
public/artifacts/
# Tailwind v4 used to sweep unignored root files into its automatic source scan,
# and a dump containing class-shaped text would turn into real utilities. That
# scan is now off at the source (`@import "tailwindcss" source(none)` in
# globals.css), so these entries are housekeeping rather than load-bearing -
# keep them anyway; a 40MB audit dump in the repo root is nobody's friend.
/outputs/
.openscad-runtime/
skills/scad-generation/learned-patterns.json
benchmark-results.txt
benchmark-render-results.json

# agent/IDE context directories
.codex/
.context/
.agent-ctx/
agent-ctx/

# development artifacts
download/
upload/
worklog*.md
keep-dev-alive.sh
replace_models.py

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.log
server.log

# agent config
.claude
.claude/
.z-ai-config
.gstack
.gstack/
.agentscad
.agentscad/
**/.agentscad
**/.agentscad/


# local scratch
local-*
test/
prompt/

# Python bytecode
__pycache__/
*.py[cod]
prisma/test.db

# agent state & local skills
.agents
.agents/
**/.agents
**/.agents/
.ralph-state
.ralph-state/
**/.ralph-state
**/.ralph-state/

