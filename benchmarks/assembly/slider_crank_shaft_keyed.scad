// Original low-speed slider-crank verification fixture, millimetres.
// Seven manufacturing parts, nine instances: two identical transverse keys
// and two identical guide retainers.
// Main shaft axial retention candidate; front guide is locked in +Z by two
// quarter-turn retainers through its side plates and the frame channel walls.
// Gravity orientation, wear and hand force are not verified.
// Baseline five parts: a removable transverse key now retains the rod on
// the eccentric pin. Main shaft and slider retention remain unresolved.
// Both keys carry a quarter-turn lug that sits in a groove inside the crank:
// withdrawal needs a deliberate 90 degree turn first. The guide retainers
// use the same principle in the 0.4 mm gap between plate and wall: upright
// they pass the wall slot, turned 90 degrees their ends bear on the wall.
// Lug and retainer strength, detent feel and physical security are unverified.
agentscad_part = "all";
agentscad_pose = false;
motion_angle = 0;
crank_radius = 8;
rod_length = 28;
$fn = 64;

// All pin axes are parallel to +Y; the mechanism moves in the XZ plane.
module y_cylinder(radius, height) { rotate([-90, 0, 0]) cylinder(r=radius, h=height); }
module crank_local() {
  difference() {
    union() {
    translate([0, -4, 0]) y_cylinder(crank_radius + 3, 4);
    translate([0, -13, 0]) y_cylinder(2, 9.1);
    translate([0, -0.1, crank_radius]) y_cylinder(2, 6.1);
    }
    translate([-3, 5, crank_radius]) rotate([0, 90, 0]) cylinder(r=0.7, h=6);
    translate([-3, -11, 0]) rotate([0, 90, 0]) cylinder(r=0.7, h=6);
    // Quarter-turn bayonet at both key holes: a circular groove inside the
    // material plus a narrow entry slot through the +X face. The lug cannot
    // pass the slot unless the key is turned back upright.
    for (hole = [[5, crank_radius], [-11, 0]]) {
      translate([1.0, hole[0], hole[1]]) rotate([0, 90, 0]) cylinder(r=1.05, h=0.5);
      translate([1.5, hole[0] - 0.3, hole[1] - 0.9]) cube([0.9, 0.6, 1.8]);
    }
  }
}
module eccentric_key_local() {
  // +X withdrawal. The quarter-turn lug is inserted upright through a slot in
  // the crank, then turned 90 degrees so it sits behind the groove wall. The
  // enlarged head stays on the positive side as a grip, not as a retainer.
  rotate([0, 90, 0]) union() {
    translate([0, 0, -4]) cylinder(r=0.5, h=8.1);
    translate([0, 0, 4]) cylinder(r=0.8, h=1);
    // Lug: 0.5 wide, 1.7 long, 0.4 thick, at local z 1.05..1.45.
    translate([-0.25, -0.85, 1.05]) cube([0.5, 1.7, 0.4]);
  }
}
module rod_local() {
  difference() {
    hull() {
      translate([0, 1, 0]) y_cylinder(4, 3);
      translate([0, 1, rod_length]) y_cylinder(4, 3);
    }
    translate([0, 0.9, 0]) y_cylinder(2.2, 3.2);
    translate([0, 0.9, rod_length]) y_cylinder(2.2, 3.2);
  }
}
module slider_local() {
  union() {
    translate([-5, 5, -5]) cube([10, 4, 10]);
    y_cylinder(2, 5.1);
  }
}
module guide_front_local() {
  difference() {
    union() {
      translate([-10.2, 9.4, 14]) cube([5.7, 1, 30]);
      translate([4.5, 9.4, 14]) cube([5.7, 1, 30]);
      translate([-10.2, 9.4, 14]) cube([20.4, 1, 1]);
    }
    // Retainer holes. The pin shaft is a close fit; the tab stays outside the
    // plate, in the gap between the plate and the frame channel wall.
    for (x = [-9.1, 9.1]) translate([x, 9.4, 40]) rotate([-90, 0, 0]) cylinder(r=0.7, h=1.1);
  }
}
module guide_lock_local() {
  // Quarter-turn guide retainer, shaft along +Y. The local frame is the locked
  // orientation: the tab is 2.4 mm across X, so it cannot pass the 1.4 mm wall
  // slot. Unlocking turns the part upright about Y; the tab then passes the
  // 2.8 mm slot height. Keeping the locked pose local means the instance is a
  // pure translation, which the ZIP reconstruction can compare face by face.
  union() {
    translate([0, 0, 0]) rotate([-90, 0, 0]) cylinder(r=0.5, h=3.15);
    translate([-1.2, 1.05, -0.25]) cube([2.4, 0.3, 0.5]);
    translate([0, 3.15, 0]) rotate([-90, 0, 0]) cylinder(r=0.8, h=1.0);
  }
}
module frame_local() {
  difference() {
    union() {
      difference() {
        translate([-14, -10, -14]) cube([28, 4, 58]);
        translate([0, -10.1, 0]) y_cylinder(2.2, 4.2);
      }
      // Rear lips retain the slider in -Y without entering the rod layer.
      translate([-9, 4.4, 14]) cube([4.5, 0.4, 30]);
      translate([4.5, 4.4, 14]) cube([4.5, 0.4, 30]);
      // Two open-top channels capture the removable front guide in +Y.
      for (side = [-1, 1]) scale([side, 1, 1]) {
        translate([8, 10.8, 14]) cube([3.4, 1.2, 30]);
        translate([10.4, 8, 12]) cube([1, 4, 32]);
        translate([8, 8, 14]) cube([3.4, 1, 30]);
        translate([8, 8, 12]) cube([3.4, 4, 1.6]);
      }
      for (x = [-9, 5.4]) {
        translate([x, 4.4, 14]) cube([3.6, 4.6, 30]);
        translate([x, -6.1, 42]) cube([3.6, 11.2, 2]);
      }
    }
    // Quarter-turn retainer slots through the outer channel walls. Upright
    // the retainer tab passes; turned 90 degrees its ends catch the wall.
    for (side = [-1, 1]) scale([side, 1, 1])
      translate([8.4, 10.8, 38.6]) cube([1.4, 1.2, 2.8]);
  }
}

// Source-side construction. The checker measures the resulting mesh contours;
// it never consumes these functions or their computed coordinates as evidence.
cx = crank_radius * sin(motion_angle);
cz = crank_radius * cos(motion_angle);
travel = sqrt(rod_length * rod_length - cx * cx);
pz = cz + travel;
rod_angle = atan2(-cx, travel);
module selected_part(id, placed) {
  if (id == "main_key") {
    if (placed) rotate([0, motion_angle, 0]) translate([0, -11, 0]) eccentric_key_local();
    else eccentric_key_local();
  }
  if (id == "eccentric_key") {
    if (placed) rotate([0, motion_angle, 0]) translate([0, 5, crank_radius]) eccentric_key_local();
    else eccentric_key_local();
  }
  if (id == "guide_front") guide_front_local();
  if (id == "guide_lock") guide_lock_local();
  if (id == "guide_lock_right") translate([9.1, 9.4, 40]) guide_lock_local();
  if (id == "guide_lock_left") translate([-9.1, 9.4, 40]) guide_lock_local();
  if (id == "frame") frame_local();
  if (id == "crank") rotate([0, placed ? motion_angle : 0, 0]) crank_local();
  if (id == "rod") translate(placed ? [cx, 0, cz] : [0, 0, 0])
    rotate([0, placed ? rod_angle : 0, 0]) rod_local();
  if (id == "slider") translate([0, 0, placed ? pz : 0]) slider_local();
}
module generated_part() {
  if (agentscad_part == "all") {
    for (id = ["frame", "crank", "rod", "slider", "eccentric_key", "guide_front", "main_key", "guide_lock_right", "guide_lock_left"]) selected_part(id, true);
  } else selected_part(agentscad_part, agentscad_pose);
}
