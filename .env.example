# Database URL for Prisma (SQLite by default)
DATABASE_URL="file:../db/dev.db"

# Provider keys can be configured after startup in Settings -> Providers.
# Local Save writes them to .agentscad/providers.json; never commit/share it.
# Environment variables are useful for unattended/shared deployments.

# Xiaomi MiMo OpenAI-compatible API
MIMO_BASE_URL="https://token-plan-cn.xiaomimimo.com/v1"
MIMO_MODEL="mimo-v2.5-pro"
# MIMO_API_KEY=""

# DeepSeek OpenAI-compatible API
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-pro"
# DEEPSEEK_API_KEY=""

# OpenRouter OpenAI-compatible API
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-5.6-sol"
# OPENROUTER_API_KEY=""
# OPENROUTER_HTTP_REFERER="http://localhost:3000"
# OPENROUTER_APP_TITLE="AgentSCAD"

# Vercel-only encrypted session storage for provider settings.
# Generate a unique secret with: openssl rand -base64 48
# Keys are stored only in an HttpOnly browser-session cookie. Browser session
# restoration varies; users can click Clear keys for an immediate wipe.
# Rotating this secret invalidates all sessions.
# PROVIDER_SETTINGS_SECRET=""
#
# Optional comma-separated exact HTTPS base URLs for trusted custom providers.
# Built-in production provider presets are already allowed.
# PROVIDER_BASE_URL_ALLOWLIST=""

# Optional OpenSCAD library search paths.
# Core rendering backend: native (default for local dev) or wasm.
# Docker Compose and serverless deployments select wasm by default.
# AGENTSCAD_OPENSCAD_BACKEND="native"
# OPENSCAD_BIN="openscad"
# Optional UI/demo pacing. Production pipeline delays default to zero.
# AGENTSCAD_DEMO_DELAY_MS="0"
# Total budget for one LLM intake/generation/repair request. Defaults to 90000 ms.
# AGENTSCAD_LLM_TIMEOUT_MS="90000"
# Legacy deterministic templates are demo-only and disabled in the product path.
# AGENTSCAD_TEMPLATE_FALLBACK="false"
# Experimental local-only prompt memory. Default false; ignored in production.
# AGENTSCAD_MEMORY_PROMPT_ENABLED="false"
#
# AgentSCAD-managed libraries default to ~/.agentscad/openscad-libraries.
# Override the managed directory only when needed.
# AGENTSCAD_OPENSCAD_LIBRARY_DIR="/Users/you/.agentscad/openscad-libraries"
# Legacy CADCAD_OPENSCAD_LIBRARY_DIR is still accepted for existing local setups.
#
# Point these at additional local BOSL/BOSL2/MCAD parent directories; do not vendor third-party code by default.
# Example macOS: OPENSCAD_LIBRARY_PATHS="/Users/you/Documents/OpenSCAD/libraries"
# Example multiple paths: OPENSCAD_LIBRARY_PATHS="/path/to/libs,/another/path"
# OPENSCAD_LIBRARY_PATHS=""

# Optional: Add other environment variables below
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# ZHIPU_API_KEY=""
# ZAI_API_KEY=""
# MOONSHOT_API_KEY=""
# MINIMAX_API_KEY=""
# ARK_API_KEY=""
# DASHSCOPE_API_KEY=""
# MISTRAL_API_KEY=""
# GROQ_API_KEY=""
# TOGETHER_API_KEY=""
# LITELLM_API_KEY=""

# Secret for cron endpoint authentication (required only when production cron is enabled).
# Use a long random string, e.g.: openssl rand -hex 32
# CRON_SECRET=""

# Optional bearer-token administrative access for job/chat/provider APIs.
# Without API_SECRET, production browser traffic must be same-origin, jobs are
# scoped with an HttpOnly browser-session cookie, and environment/file-backed
# provider credentials are disabled. Public deployments must use encrypted
# per-browser BYO keys via PROVIDER_SETTINGS_SECRET. This is not an account system.
# If both secrets are configured, use a different value than CRON_SECRET.
# API_SECRET=""
