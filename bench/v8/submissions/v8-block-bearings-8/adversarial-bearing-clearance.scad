agentscad_part = "all";
crank_angle = 0;
$fn = 32;
r = 8; L = 28; half = 45;
ux = sin(half); uz = cos(half);
station_y = [-30, -10, 10, 30];
phase = [0, 90, 180, 270];
bank_y = 3; rod_y = 5;
function px(a) = r * sin(a);
function pz(a) = r * cos(a);
function travel(a, sx) = px(a) * sx + pz(a) * uz + sqrt(L * L - (px(a) * px(a) + pz(a) * pz(a) - pow(px(a) * sx + pz(a) * uz, 2)));
function phi(a, sx) = atan2(travel(a, sx) * sx - px(a), travel(a, sx) * uz - pz(a));

module frame_part() {
  union() {
    // Base plate (unchanged from the packaging carrier).
    translate([0,0,-20]) cube([32, 85, 3], center = true);
    // Crankcase/block bearing webs: three main-bearing plates with a journal
    // bore, one top rail tying them together. The plates sit at y planes where
    // the rotating crank has only the main journal, and the webs stay inside
    // |x| <= 3 so the slider and rod sweeps are not touched.
    // Two main-bearing webs at the between-station journals y = -20 / +20.
    for (by = [-20, 20]) {
      translate([0, by, 0]) difference() {
        cube([6, 1, 46], center = true);
        rotate([90,0,0]) cylinder(h = 3, r = 2.9, center = true, $fn = 48);
      }
    }
    // Top rail ties both webs to the base plate through their lower halves.
    translate([0, 0, 22]) cube([6, 44, 2], center = true);
  }
}
module crank_part() {
  union() {
    // Four shared crankpins between webs.
    for (i = [0:3]) {
      translate([px(phase[i]), station_y[i], pz(phase[i])])
        rotate([90,0,0]) cylinder(h = 16, r = 2, center = true);
      // Webs sit in the gap between the two rod planes of each shared pin.
      for (s = [-8, 8]) {
        translate([0, station_y[i] + s, 0]) hull() {
          rotate([90,0,0]) cylinder(h = 1, r = 2.5, center = true);
          translate([px(phase[i]), 0, pz(phase[i])]) rotate([90,0,0]) cylinder(h = 1, r = 2.5, center = true);
        }
      }
    }
    // Main journals between station webs, plus end stubs: one connected crank.
    for (m = [-20, 0, 20]) translate([0, m, 0]) rotate([90,0,0]) cylinder(h = 4, r = 2, center = true);
    translate([0, -39, 0]) rotate([90,0,0]) cylinder(h = 2, r = 2, center = true);
    translate([0, 39, 0]) rotate([90,0,0]) cylinder(h = 2, r = 2, center = true);
  }
}
module rod_local() {
  difference() {
    hull() {
      translate([0,0,0]) rotate([90,0,0]) cylinder(h=4,r=4,center=true);
      translate([0,0,L]) rotate([90,0,0]) cylinder(h=4,r=3,center=true);
    }
    translate([0,0,0]) rotate([90,0,0]) cylinder(h=6,r=2.2,center=true);
  }
  translate([0,0,L]) rotate([90,0,0]) cylinder(h=12,r=2,center=true);
}
module slider_local() {
  difference() {
    cylinder(h=14,r=9.75,center=true);
    rotate([90,0,0]) cylinder(h=20,r=2.2,center=true);
    translate([0,2,-6]) cylinder(h=4,r=7,center=true);
    translate([0,2,0]) cylinder(h=8,r=5.5,center=true);
    translate([0,-2,-6]) cylinder(h=4,r=7,center=true);
    translate([0,-2,0]) cylinder(h=8,r=5.5,center=true);
  }
}
module rod_pose(i, side) {
  sx = side == 0 ? ux : -ux;
  a = phase[i] + crank_angle;
  translate([px(a), station_y[i] + (side == 0 ? -rod_y : rod_y), pz(a)])
    rotate([0, phi(a, sx), 0]) rod_local();
}
module slider_pose(i, side) {
  sx = side == 0 ? ux : -ux;
  a = phase[i] + crank_angle;
  translate([travel(a, sx) * sx, station_y[i] + (side == 0 ? -bank_y : bank_y), travel(a, sx) * uz])
    rotate([0, atan2(sx, uz), 0]) slider_local();
}
module posed() {
  frame_part(); rotate([0,crank_angle,0]) crank_part();
  for (i=[0:3]) for (side=[0:1]) {
    // The complete assembly is generated by the selectors below; this branch
    // is intentionally not used for per-part export.
  }
}
module generated_part() {
  if (agentscad_part == "frame") frame_part();
  else if (agentscad_part == "crank") rotate([0,crank_angle,0]) crank_part();
  else {
    // Selector names rod0L, rod0R, ..., slider3R.
    for (i=[0:3]) for (side=[0:1]) {
      if (agentscad_part == str("rod", i, side == 0 ? "L" : "R")) rod_pose(i, side);
      if (agentscad_part == str("slider", i, side == 0 ? "L" : "R")) slider_pose(i, side);
    }
  }
}
generated_part();
